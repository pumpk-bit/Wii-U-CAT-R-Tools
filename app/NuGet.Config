<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only nuget.org: the .NET SDK downloads its own runtime and build packs from there. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
