diff --git a/pkg/cat-dev/src/net/private.rs b/pkg/cat-dev/src/net/private.rs
index 7cb0af9..80a4878 100644
--- a/pkg/cat-dev/src/net/private.rs
+++ b/pkg/cat-dev/src/net/private.rs
@@ -24,3 +24,33 @@ pub fn trace_buffer(prefix: &str, data: &[u8]) {
 		"{prefix}",
 	);
 }
+
+/// Whether `PCFS_TRACE` is set in the environment.
+///
+/// Unlike [`trace_buffer`] this works in release builds and needs no tracing
+/// subscriber: it is what pcfsserver's `-Trace` mode uses to log raw traffic.
+pub fn stderr_trace_enabled() -> bool {
+	static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+	*ENABLED.get_or_init(|| std::env::var_os("PCFS_TRACE").is_some())
+}
+
+/// When `PCFS_TRACE` is set, print a timestamped tag, the length, and the
+/// first 96 bytes of `data` as hex to stderr.
+pub fn stderr_trace(tag: &str, data: &[u8]) {
+	if !stderr_trace_enabled() {
+		return;
+	}
+	let shown = &data[..data.len().min(96)];
+	let mut hex = String::with_capacity(shown.len() * 2);
+	for b in shown {
+		let _ = write!(&mut hex, "{b:02x}");
+	}
+	let millis = std::time::SystemTime::now()
+		.duration_since(std::time::UNIX_EPOCH)
+		.map_or(0, |d| d.as_millis() % 100_000_000);
+	eprintln!(
+		"[{millis:>8}] {tag} len={} {hex}{}",
+		data.len(),
+		if data.len() > shown.len() { "..." } else { "" },
+	);
+}
