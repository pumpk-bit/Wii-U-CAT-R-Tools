+	/// Write raw bytes straight to the TCP stream while a request is still
+	/// being handled (before its normal response is sent).
+	///
+	/// Needed for PCFS large FFIO writes, where the server must answer the
+	/// WriteFile header with a "first response" before the console streams
+	/// the file data.
+	///
+	/// ## Errors
+	///
+	/// If the stream is no longer available, or the write fails.
+	#[cfg_attr(docsrs, doc(cfg(feature = "servers")))]
+	#[cfg(feature = "servers")]
+	pub async fn unsafe_write_bytes_to_stream(&self, data: &[u8]) -> Result<(), CatBridgeError> {
+		if let Some(strm) = self.stream_access.as_ref() {
+			let mut guard = strm.lock().await;
+			if let Some((_, stream)) = guard.as_mut() {
+				stream.writable().await.map_err(NetworkError::IO)?;
+				tokio::io::AsyncWriteExt::write_all(stream, data)
+					.await
+					.map_err(NetworkError::IO)?;
+				return Ok(());
+			}
+		}
+
+		error!("called unsafe_write_bytes_to_stream on a stream that is not processing!");
+		Err(CommonNetNetworkError::StreamNoLongerProcessing.into())
+	}
